# NASA EONET API Endpoint (query parameters limit=500 optimizes fetch speed)
REACT_APP_NASA_EONET_API_URL=https://eonet.gsfc.nasa.gov/api/v2.1/events?limit=500

# Google Maps JavaScript API Key (Optional)
REACT_APP_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# OpenWeatherMap API Key (Optional: for live Wind / Weather tile overlays)
REACT_APP_OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE

# World Air Quality Index (WAQI) Token (Optional: for live PM2.5 / AQI heatmap tiles)
REACT_APP_WAQI_API_TOKEN=YOUR_WAQI_API_TOKEN_HERE
